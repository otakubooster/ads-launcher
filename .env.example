# Copy to .env.local (web) / .env (worker). Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Job queues
REDIS_URL=

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Meta
META_API_VERSION=v26.0
META_APP_ID=
# Sign every call with appsecret_proof; turn on "Require app secret" in the Meta app
META_APP_SECRET=

REPORTING_CURRENCY=USD

# Creative storage: "supabase" (default when SUPABASE_SERVICE_ROLE_KEY is set) uses the
# private "creatives" bucket; "local" writes to STORAGE_DIR and serves signed URLs from APP_URL.
# STORAGE_DRIVER=local
# STORAGE_DIR=/var/tmp/fahd-storage
APP_URL=http://localhost:3000
# Video processing poll interval (spec: 10 s)
# META_VIDEO_POLL_MS=10000
# Optional pinned rates (units of REPORTING_CURRENCY per 1 unit). Without it, daily ECB
# rates come from api.frankfurter.app and are cached in Redis for 12 hours.
# FX_RATES={"EUR":1.08,"GBP":1.27}

# Alerts and monitoring
RESEND_API_KEY=
SENTRY_DSN=

# Phase 2 Claude panel only
ANTHROPIC_API_KEY=

# --- Local development only (both are ignored when NODE_ENV=production) ---
# Pick a seeded member on /login instead of Supabase Auth.
# DEV_AUTH=1
# Send Meta calls to the fake Graph server (pnpm fake-meta); tokens starting EAAFAKE work.
# META_GRAPH_HOST=http://127.0.0.1:4010
