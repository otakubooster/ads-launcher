# Copy to .env.local (web) / .env (worker). Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Job queues
REDIS_URL=

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Meta
META_API_VERSION=v26.0
META_APP_ID=
# Sign every call with appsecret_proof; turn on "Require app secret" in the Meta app
META_APP_SECRET=

REPORTING_CURRENCY=USD

# Alerts and monitoring
RESEND_API_KEY=
SENTRY_DSN=

# Phase 2 Claude panel only
ANTHROPIC_API_KEY=
