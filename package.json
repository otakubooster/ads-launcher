{
  "name": "fahd-ads-launcher",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fahd/web dev",
    "worker": "pnpm --filter @fahd/worker dev",
    "fake-meta": "pnpm --filter @fahd/meta fake",
    "db:generate": "pnpm --filter @fahd/db generate",
    "db:migrate": "pnpm --filter @fahd/db migrate",
    "db:seed": "pnpm --filter @fahd/db seed",
    "db:studio": "pnpm --filter @fahd/db studio",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @fahd/web e2e"
  }
}
