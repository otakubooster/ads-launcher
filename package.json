{
  "name": "fahd-ads-launcher",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fahd/web dev",
    "worker": "pnpm --filter @fahd/worker dev",
